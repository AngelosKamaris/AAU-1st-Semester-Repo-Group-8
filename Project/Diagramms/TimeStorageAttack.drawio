    <diagram name="Time-storage attack" id="time-storage-attack">
        <mxGraphModel dx="787" dy="293" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n2" parent="1" style="html=1;whiteSpace=wrap;fontSize=24;fontColor=#222222;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;spacingLeft=6;" value="Time-storage attack: keep part of the table, brute-force the rest" vertex="1">
                    <mxGeometry height="34" width="1220" x="40" y="14" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=6;" value="The cheater keeps a share &lt;i&gt;p&lt;/i&gt; of the table. It never fails: a miss costs hash calls instead." vertex="1">
                    <mxGeometry height="24" width="1220" x="40" y="52" as="geometry"/>
                </mxCell>
                <mxCell id="n4" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f4f7fc;strokeColor=#9db4e0;strokeWidth=1.5;" value="" vertex="1">
