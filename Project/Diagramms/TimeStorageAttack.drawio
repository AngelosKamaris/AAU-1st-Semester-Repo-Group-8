                </mxCell>
                <mxCell id="n5" parent="1" style="html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;spacingLeft=6;" value="1.&amp;nbsp; SETUP: build the table, keep only a share &lt;i&gt;p&lt;/i&gt; of the entries" vertex="1">
                    <mxGeometry height="26" width="900" x="50" y="96" as="geometry"/>
                </mxCell>
                <mxCell id="n6" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f2f3f4;strokeColor=#909497;strokeWidth=1.5;dashed=1;" value="x = 0&lt;br&gt;dropped" vertex="1">
                    <mxGeometry height="62" width="92" x="60" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n7" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f2f3f4;strokeColor=#909497;strokeWidth=1.5;dashed=1;" value="x = 1&lt;br&gt;dropped" vertex="1">
                    <mxGeometry height="62" width="92" x="172" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n8" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontStyle=1;" value="x = 2&lt;br&gt;stored" vertex="1">
                    <mxGeometry height="62" width="92" x="284" y="136" as="geometry"/>
