                        <mxPoint x="505" y="405" as="sourcePoint"/>
                        <mxPoint x="620" y="405" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n22" parent="1" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1e8449;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;spacingLeft=6;" value="yes (prob. p)" vertex="1">
                    <mxGeometry height="20" width="100" x="525" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="1" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontStyle=1;" value="Return the stored x&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;0 hash calls&lt;/span&gt;" vertex="1">
                    <mxGeometry height="74" width="300" x="620" y="368" as="geometry"/>
                </mxCell>
                <mxCell id="n24" edge="1" parent="1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#d35400;strokeWidth=2.4;exitX=0.5;exitY=1.014;exitDx=0;exitDy=0;exitPerimeter=0;">
                    <mxGeometry relative="1" x="0.0164" as="geometry">
                        <Array as="points">
                            <mxPoint x="385" y="528.46"/>
                        </Array>
                        <mxPoint x="385" y="460" as="sourcePoint"/>
                        <mxPoint x="620" y="528.46" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n25" parent="1" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#d35400;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;spacingLeft=6;" value="no (prob. 1 - p)" vertex="1">
                    <mxGeometry height="20" width="130" x="389" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#fdebd0;strokeColor=#d35400;strokeWidth=2;" value="&lt;b&gt;Brute force over the DROPPED inputs only&lt;/b&gt;:&lt;br&gt;compute f(x), stop when f(x) = y&lt;br&gt;&lt;br&gt;Stored x are skipped: for them f(x) is&lt;br&gt;already known and it is not y." vertex="1">
                    <mxGeometry height="110" width="360" x="620" y="475" as="geometry"/>
                </mxCell>
                <mxCell id="n27" edge="1" parent="1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#d35400;strokeWidth=2.4;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="979" y="529.5" as="sourcePoint"/>
                        <mxPoint x="1019" y="529.5" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n28" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#fdebd0;strokeColor=#d35400;strokeWidth=2;fontStyle=1;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Return x&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;up to (1-p)*N&amp;nbsp;hash calls&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="92" width="220" x="1020" y="484" as="geometry"/>
                </mxCell>
                <mxCell id="n29" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=6;" value="Average cost per challenge:  p * 0  +  (1-p) * (1-p)*N/2  =  (1-p)^2 * N / 2 hash calls.     &lt;b&gt;Always answers correctly.&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;p = 1: the honest prover (0 calls).&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;p = 0: pure brute force, about N/2 calls.     Less storage means more time (S + T is about N).&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="70" width="1180" x="60" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="1" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;rhombus;fillColor=#fef9e7;strokeColor=#b7950b;strokeWidth=2;fontStyle=1;" value="Is y in the&lt;br&gt;stored table?" vertex="1">
                    <mxGeometry height="110" width="240" x="265" y="350" as="geometry"/>
                </mxCell>
            </root>
