                <mxCell id="n10" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f2f3f4;strokeColor=#909497;strokeWidth=1.5;dashed=1;" value="x = 4&lt;br&gt;dropped" vertex="1">
                    <mxGeometry height="62" width="92" x="508" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontStyle=1;" value="x = 5&lt;br&gt;stored" vertex="1">
                    <mxGeometry height="62" width="92" x="620" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontStyle=1;" value="x = 6&lt;br&gt;stored" vertex="1">
                    <mxGeometry height="62" width="92" x="732" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f2f3f4;strokeColor=#909497;strokeWidth=1.5;dashed=1;" value="x = 7&lt;br&gt;dropped" vertex="1">
                    <mxGeometry height="62" width="92" x="844" y="136" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=6;" value="Example: N = 8 inputs, the cheater keeps 3 entries (y -&amp;gt; x) for x = 2, 5, 6, so p = 3/8.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;For the dropped x: it has thrown away both x and f(x).&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;For the stored x: it knows f(x) (it is in the table)." vertex="1">
                    <mxGeometry height="70" width="900" x="60" y="208" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="1" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#eafaf1;strokeColor=#1e8449;strokeWidth=2;fontStyle=1;" value="Storage:  p * N entries&lt;br&gt;&lt;br&gt;(honest prover: N entries)" vertex="1">
                    <mxGeometry height="144" width="260" x="990" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f4f7fc;strokeColor=#9db4e0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="372" width="1240" x="30" y="306" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="1" style="html=1;whiteSpace=wrap;fontSize=16;fontColor=#222222;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;spacingLeft=6;" value="2.&amp;nbsp; CHALLENGE: the verifier sends y = f(x*), x* unknown" vertex="1">
                    <mxGeometry height="26" width="900" x="50" y="316" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="1" style="html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;" value="challenge y" vertex="1">
                    <mxGeometry height="50" width="140" x="60" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="n19" edge="1" parent="1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;">
                    <mxGeometry relative="1" as="geometry">
