<mxCell id="c26" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c28" value="Honest prover: 1 lookup, no hashing&lt;br&gt;Without the table: up to N hashes per challenge&lt;br&gt;Verifier: 1 hash to check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#222222;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="460" height="120" as="geometry"/></mxCell>
