<mxfile host="app.diagrams.net"><diagram name="Basic implementation" id="Basic impl"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Basic Proof of Space&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontColor=#222222;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Shared:&lt;/b&gt; f(x) = BLAKE2b(seed, x), &amp;nbsp; x from 0 to N-1, &amp;nbsp; N = 2&lt;sup&gt;n_bits&lt;/sup&gt; &amp;nbsp; (functions.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1020" height="45" as="geometry"/></mxCell>
<mxCell id="c5" value="Prover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="500" height="600" as="geometry"/></mxCell>
<mxCell id="c6" value="Verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=40;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="560" y="135" width="500" height="600" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Setup&lt;/b&gt; (once)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#222222;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="300" height="25" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Proof&lt;/b&gt; (every challenge)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#222222;text;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="455" width="300" height="25" as="geometry"/></mxCell>
<mxCell id="c9" value="1. Get seed and N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="210" y="200" width="300" height="45" as="geometry"/></mxCell>
<mxCell id="c10" value="2. Compute f(x) for every x&lt;br&gt;(build_plot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="210" y="270" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c11" value="3. Store table y → x&lt;br&gt;(Plot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="210" y="345" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c12" value="Plot&lt;br&gt;y → x" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="120" height="90" as="geometry"/></mxCell>
<mxCell id="c13" value="4. Uses the same seed, so the same f" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="420" height="50" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c17" value="seed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c18" value="5. Pick random x, send y = f(x)&lt;br&gt;(sample_challenge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="420" height="50" as="geometry"/></mxCell>
<mxCell id="c19" value="6. Look up y in the table&lt;br&gt;(answer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c20" value="8. Check f(x) = y&lt;br&gt;(is_valid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="600" y="590" width="420" height="50" as="geometry"/></mxCell>
